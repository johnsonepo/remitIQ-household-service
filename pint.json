{
    "preset": "laravel",
    "rules": {
        "array_syntax": {
            "syntax": "short"
        },
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "single_quote": true,
        "trailing_comma_in_multiline": true,
        "no_unused_imports": true,
        "method_argument_space": {
            "on_multiline": "ensure_single_line"
        }
    }
}